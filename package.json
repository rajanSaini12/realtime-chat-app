{
  "name": "realtime-chat-app",
  "version": "1.0.0",
  "private": true,
  "description": "Real-time chat with private and group conversations using Socket.io, PostgreSQL and Redis pub/sub.",
  "type": "module",
  "main": "src/index.js",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch --env-file-if-exists=.env src/index.js",
    "migrate": "node src/db/migrate.js",
    "test": "node --test --test-concurrency=1 test/",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write ."
  },
  "author": "Rajan Kumar Saini",
  "license": "MIT",
  "dependencies": {
    "@socket.io/redis-adapter": "^8.3.0",
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.4.2",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.1",
    "redis": "^5.12.1",
    "socket.io": "^4.8.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "pg-mem": "^3.0.14",
    "prettier": "^3.9.10",
    "socket.io-client": "^4.8.4",
    "supertest": "^7.3.1"
  }
}
