# Copy to .env for local development: cp .env.example .env
# Never commit a real .env file.

NODE_ENV=development
PORT=3000
# Shown in /api/health and in the client header so you can see which instance served you.
INSTANCE_ID=local

# PostgreSQL connection string
DATABASE_URL=postgres://chat:chat@localhost:5432/chat

# Redis is used by the Socket.io adapter (pub/sub) to sync events across instances.
# Leave empty to run a single instance with the in-memory adapter.
REDIS_URL=redis://localhost:6379

# Must be the same on every app instance, otherwise a token issued by one instance
# is rejected by another. Use a long random value (e.g. `openssl rand -hex 32`).
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d

# bcrypt cost factor (higher = slower hashing = harder to brute force)
BCRYPT_ROUNDS=10
